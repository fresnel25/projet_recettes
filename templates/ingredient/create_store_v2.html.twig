{% extends 'base.html.twig' %}

{% block title %}Formulaire Ingredient!
{% endblock %}

{% block body %}


	<div class="d-flex justify-content-center">
		<div class="card w-50 mt-5">
			<div class="card-header">
				<h2 class="text-center">Formulaire Ingredient</h2>
			</div>
			<div class="w-75 mt-5 card-body">
				{{ form_start(formulaire, {attr: {'novalidate': 'novalidate'}}) }}
				<div class="mb-3">
					{{ form_label(formulaire.nom) }}
					{{ form_widget(formulaire.nom, {'attr': {'class': 'form-control'}}) }}
					{{ form_help(formulaire.nom, { 'help': 'le nom est obligatoire' }) }}
					{{ form_errors(formulaire.nom) }}
				</div>
				<div class="mb-3">
					{{ form_label(formulaire.prix) }}
					{{ form_widget(formulaire.prix, {'attr': {'class': 'form-control'}}) }}
					{{ form_help(formulaire.prix, { 'help': 'le prix est obligatoire' }) }}
					{{ form_errors(formulaire.prix) }}
				</div>
				{{ form_row(formulaire.submit, { 'label': 'Enregistrer' , 'attr': {'class': 'btn btn-primary'}}
				) }}
				{{ form_end(formulaire) }}
			</div>
		</div>
	</div>

{% endblock %}
