{% extends 'base.html.twig' %}

{% block title %}Hello IngredientController!
{% endblock %}

{% block body %}


	<div class="">
		<table class="table">
			<thead class="table-dark">
				<tr>
					<td>N°</td>
					<td>Nom</td>
					<td>Prix(Euro)</td>
					<td>Date de création</td>
				</tr>
			</thead>
			<tbody>
				{% for ingredient in ingredients %}
					<tr>
						<td>{{ ingredient.id }}</td>
						<td>{{ ingredient.nom }}</td>
						<td>{{ ingredient.prix }}</td>
						<td>{{ ingredient.createdAt|date('Y-m-d H:i:s') }}</td>

					</tr>
				{% endfor %}
			</tbody>

		</table>

	</div>
{% endblock %}
